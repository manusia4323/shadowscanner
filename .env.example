# Konfigurasi ShadowScanner

# Port tempat UI lokal dilayani (angka 1024-65535). Jangan pakai port <1024
# tanpa hak istimewa (root/sudo), karena browser biasanya tidak bisa aksesnya.
SHADOWSCANNER_PORT=8787

# Berapa lama riwayat (peringatan, koneksi, hasil pindaian) disimpan,
# dalam jam. Nilai 1-720. Default 8 jam agar database tetap kecil.
SHADOWSCANNER_RETENTION_HOURS=8

# Jarak antar pemindaian otomatis koneksi lokal, dalam detik.
# Default 60 detik.
SHADOWSCANNER_SCAN_INTERVAL_SECONDS=60

# Mode peringatan: jika true, notifikasi suara/bendera muncul setiap kali
# ada peringatan baru. Jika false, hanya terekam di Riwayat.
SHADOWSCANNER_WARNING_MODE=false

# Tingkat log yang direkam: "debug", "info", "warn", atau "error".
SHADOWSCANNER_LOG_LEVEL=info

# Batas maksimum perangkat yang dicatat. Perangkat tambahan tidak disimpan
# sementara batas 1-1024.
SHADOWSCANNER_MAX_DEVICES=256

# Lokasi file database SQLite lokal (tempat semua data disimpan).
SHADOWSCANNER_DB_PATH=./shadowscanner.db
